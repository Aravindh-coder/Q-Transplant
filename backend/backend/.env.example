# Copy to .env and fill in real values. Never commit the real .env file.

# --- database ---
DATABASE_URL=sqlite:///./qtransplant.db
# for production: postgresql://user:password@host:5432/qtransplant
# (postgres:// URLs and missing sslmode are auto-corrected for Aiven-style hosts)

# --- auth ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
ACCESS_TOKEN_MINUTES=720
OTP_EXPIRY_MINUTES=10
MIN_PASSWORD_LENGTH=8

# --- organizer email (SMTP sender for OTP + all system emails) ---
ORGANIZER_EMAIL=your-organizer-email@example.com
ORGANIZER_APP_PASSWORD=replace-with-gmail-app-password

# --- first organizer login (distinct from the SMTP identity above) ---
# Set once, redeploy, then rotate/remove the password. Only ever creates
# the FIRST organizer account -- never overwrites an existing one.
ORGANIZER_BOOTSTRAP_EMAIL=admin@your-domain.example
ORGANIZER_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# --- AI-assisted doctor identity verification (both optional) ---
# If GROQ_API_KEY is set it's used; otherwise ANTHROPIC_API_KEY is used if
# present. Neither set -> the organizer just reviews the two photos manually.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- document storage (strongly recommended in production) ---
# Any S3-compatible provider (AWS S3, Cloudflare R2, Backblaze B2, ...).
# Without these set, uploaded documents are written to local disk and are
# lost on the next deploy/restart of an ephemeral host like Render.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto

# --- cors ---
# Only needed if something other than this app's own served frontend calls
# the API from a different origin (a separate admin panel, local dev server).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- rate limiting ---
LOGIN_RATE_LIMIT=10
OTP_RATE_LIMIT=5
UPLOAD_RATE_LIMIT=20
RATE_LIMIT_WINDOW_MINUTES=15
