# Q-Transplant Enterprise Platform Environment Template
ENV=development

# Database Settings (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./qtransplant.db
# DATABASE_URL=postgresql://qtransplant:SecretPostgresPassword2026!@localhost:5432/qtransplant_db

# Security & JWT Token Secrets (MUST be changed in production)
JWT_SECRET=super-secret-transplant-key-change-in-production-32-bytes-min!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@qtransplant.org
SMTP_PASSWORD=secret-smtp-password
SMTP_FROM_EMAIL=notifications@qtransplant.org
SMTP_TLS=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
